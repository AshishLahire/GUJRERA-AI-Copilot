# Copy to .env and adjust. Never commit .env or real API keys.

# Fully offline mode (disables all Gemini calls at code level)
OFFLINE_MODE=false
# OCR engine priority ("gemini_first" or "qwen_first")
OCR_ENGINE_PREFERENCE=gemini_first
# Local LLM model for offline claim extraction (Ollama)
LOCAL_LLM_MODEL=qwen3-vl:4b

# Enable local Ollama VLM checks (set to false to skip Ollama and use Gemini fallback when allowed)
OLLAMA_ENABLED=true
# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
# Vision-language model served by Ollama (used for low-confidence OCR escalation)
VLM_MODEL=qwen3-vl:8b
# Gemini API key (optional; leave empty to disable the hosted fallback)
GEMINI_API_KEY=
# Gemini model name used when the hosted fallback is enabled
GEMINI_MODEL=gemini-3.5-flash-lite
# Models tried for claim extraction when GEMINI_MODEL is overloaded or not found, comma-separated (empty = none)
GEMINI_FALLBACK_MODELS=gemini-flash-latest
# Per-request timeout in seconds for Gemini API calls
GEMINI_TIMEOUT_SECONDS=30
# Media resolution for Gemini image input ("low" or "default")
GEMINI_MEDIA_RESOLUTION=default
# Maximum number of hosted API calls per day
API_DAILY_CALL_LIMIT=50
# OCR languages, comma-separated (hi,en) or JSON (["hi","en"])
OCR_LANGUAGES=hi,en
# Minimum tier-1 OCR confidence (0.0-1.0) before escalating to the VLM
TIER1_CONFIDENCE_THRESHOLD=0.80
# SQLite file used to cache OCR results
CACHE_DB_PATH=data/cache/ocr_cache.sqlite
# Images are downscaled so their longest side is at most this many pixels
MAX_IMAGE_LONG_SIDE=1600

# --- GUJRERA copilot ---
# SQLAlchemy URL of the RERA records database (SQLite file or postgresql+psycopg://...)
GUJRERA_DB_URL=sqlite:///data/gujrera/gujrera.sqlite
# Seed for the reproducible mock data generator
GUJRERA_MOCK_SEED=2016
# Maximum rows returned by an analytics query
GUJRERA_MAX_ROWS=500
# Optional: let a self-hosted LLM (Ollama) rephrase chat answers; kept only if citations survive
GUJRERA_LLM_PHRASING=false
GUJRERA_LLM_MODEL=qwen3-vl:4b
GUJRERA_LLM_BASE_URL=http://localhost:11434
GUJRERA_LLM_TIMEOUT_SECONDS=20
